{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (J-Link)",
            "request": "launch",
            "type": "cortex-debug",
            "cwd": "${workspaceRoot}",
            "preLaunchTask": "Build",
            "servertype": "jlink",
            "executable": "bin/eval-eth.elf",
            "device": "STM32F746NG",
            "interface": "swd",
            "svdFile": ".vscode/STM32F746.svd"
        },
        {
            "name": "Debug (OpenOCD)",
            "request": "launch",
            "type": "cortex-debug",
            "cwd": "${workspaceRoot}",
            "preLaunchTask": "Build",
            "servertype": "openocd",
            "executable": "bin/eval-eth.elf",
            "device": "STM32F746NG",
            "svdFile": ".vscode/STM32F746.svd",
            "configFiles": [
                // stlink-dap.cfg from OpenOCD config generated by STM32CubeIDE
                "/usr/share/openocd/scripts/interface/stlink-dap.cfg",
                "/usr/share/openocd/scripts/target/stm32f7x.cfg"
            ]
        }
    ]
}